<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wisdom.farm.mapper.DeviceMapper">
    <resultMap id="DeviceResultMap" type="com.wisdom.farm.entity.Device">
        <id property="id" column="id"/>
        <result property="landId" column="land_id"/>
        <result property="name" column="name"/>
        <result property="type" column="type"/>
        <result property="sn" column="sn"/>
        <result property="secret" column="secret"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectBySn" resultMap="DeviceResultMap">
        SELECT id, land_id, name, type, sn, secret, status, create_time, update_time
        FROM device
        WHERE sn = #{sn}
    </select>

    <select id="selectById" resultMap="DeviceResultMap">
        SELECT id, land_id, name, type, sn, secret, status, create_time, update_time
        FROM device
        WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="DeviceResultMap">
        SELECT id, land_id, name, type, sn, secret, status, create_time, update_time
        FROM device
        ORDER BY create_time DESC
    </select>

    <update id="resetSecret">
        UPDATE device
        SET secret = #{secret}, update_time = NOW()
        WHERE id = #{id}
    </update>
</mapper>

<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="text"
    class="tab-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-icon">
      <view wx:if="{{item.icon === 'home'}}" class="icon icon-home"></view>
      <view wx:elif="{{item.icon === 'land'}}" class="icon icon-land"></view>
      <view wx:elif="{{item.icon === 'bell'}}" class="icon icon-bell"></view>
      <view wx:elif="{{item.icon === 'user'}}" class="icon icon-user"></view>
    </view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>

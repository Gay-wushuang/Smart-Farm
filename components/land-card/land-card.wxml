<view class="card" bindtap="onTap">
  <image class="cover" src="{{land.image || '/assets/images/land-default.svg'}}" mode="aspectFill" />
  <view class="content">
    <view class="title-row">
      <view>
        <view class="name">{{land.landName || land.name}}</view>
        <view class="code">编号 {{land.landNo || land.landId || '-'}}</view>
      </view>
      <status-tag text="{{statusText}}" type="{{statusType}}"></status-tag>
    </view>
    <view class="meta">
      <view>面积 {{land.area || '-'}}{{land.areaUnit || '㎡'}}</view>
      <view>剩余 {{land.remainDays || land.remainingDays || '-'}} 天</view>
    </view>
    <view class="price">¥{{price}} <text>{{land.priceUnit || '元/年'}}</text></view>
  </view>
</view>

# MySQL Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=fanclub

# JWT Configuration
JWT_SECRET=change-this-secret-at-least-32-bytes
JWT_EXPIRE_MINUTES=10080

# WeChat Mini Program Configuration
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret

# WeChat Pay API v3 Configuration
WECHAT_PAY_MCH_ID=your_mch_id
WECHAT_PAY_APPID=your_wechat_appid
WECHAT_PAY_SERIAL_NO=your_merchant_certificate_serial_no
WECHAT_PAY_PRIVATE_KEY_PATH=/path/to/apiclient_key.pem
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=your_api_v3_key
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=/path/to/wechatpay_public_key.pem
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/pay/notify/wechat

# GitHub Configuration
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat

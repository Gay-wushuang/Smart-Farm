# ===========================================
# 智慧农场土地认领系统 - 环境变量配置
# ===========================================
# 复制此文件为 .env 并填写真实值
# cp .env.example .env

# -------------------------------------------
# MySQL 数据库配置
# -------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=wisdom_farm

# -------------------------------------------
# JWT Token 配置
# -------------------------------------------
JWT_SECRET=change-this-secret-at-least-32-characters-long-random-string
JWT_EXPIRE_MINUTES=10080

# -------------------------------------------
# 微信小程序配置（登录、手机号获取）
# -------------------------------------------
# 获取地址：https://mp.weixin.qq.com → 开发管理 → 开发设置 → AppID
WECHAT_APPID=wx0000000000000000
WECHAT_SECRET=00000000000000000000000000000000

# -------------------------------------------
# 微信支付 API v3 配置（重要！联调前必填）
# -------------------------------------------
# 商户号：https://pay.weixin.qq.com → 账户中心 → 商户信息
WECHAT_PAY_MCH_ID=1000000000

# 商户AppID（与上面小程序 AppID 保持一致）
WECHAT_PAY_APPID=wx0000000000000000

# 商户证书序列号（32位十六进制字符串）
# 获取：账户中心 → API安全 → 申请API证书 → 查看证书序列号
WECHAT_PAY_SERIAL_NO=00000000000000000000000000000000

# 商户API私钥（完整内容，含 -----BEGIN PRIVATE KEY----- 头尾）
# 方式1：填写私钥内容（推荐用于容器化部署）
WECHAT_PAY_PRIVATE_KEY=

# 方式2：指定私钥文件路径（本地开发使用）
# WECHAT_PAY_PRIVATE_KEY_PATH=/path/to/cert/apiclient_key.pem

# API v3 密钥（32位字符串）
# 设置位置：账户中心 → API安全 → 设置APIv3密钥
WECHAT_PAY_API_V3_KEY=your32characterapiv3keystring

# 平台公钥/证书路径（用于验签）
# 下载：账户中心 → API安全 → 申请API证书 → 查看微信支付平台证书
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=/path/to/cert/wechatpay_public_key.pem

# 支付回调通知地址（必须为 HTTPS 可访问的公网地址）
# 本地调试可用 ngrok/frp 等内网穿透工具
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/pay/notify/wechat

# -------------------------------------------
# GitHub 配置（可选）
# -------------------------------------------
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat

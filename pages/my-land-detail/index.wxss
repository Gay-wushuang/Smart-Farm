.hero { width: 100%; height: 360rpx; border-radius: 18rpx; background: #dfe8da; }
.detail { margin-top: 24rpx; padding: 28rpx; }
.summary { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-top: 24rpx; }
.summary view { padding: 22rpx; border-radius: 14rpx; background: #f7faf5; }
.summary text { display: block; color: #778273; font-size: 24rpx; }
.summary .strong { display: block; margin-top: 8rpx; font-size: 30rpx; }
.actions { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 28rpx; }
.actions button { height: 100rpx; border-radius: 16rpx; background: #fff; color: #2f8f46; font-size: 30rpx; font-weight: 700; box-shadow: 0 10rpx 24rpx rgba(47,91,54,.06); }

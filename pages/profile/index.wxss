.user { display: flex; align-items: center; gap: 22rpx; padding: 30rpx; }
.avatar { width: 96rpx; height: 96rpx; border-radius: 50%; background: #2f8f46; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 42rpx; font-weight: 800; }
.login { margin-left: auto; width: 116rpx; height: 64rpx; border-radius: 999rpx; background: #2f8f46; color: #fff; font-size: 25rpx; }
.menu { margin-top: 28rpx; padding: 0 24rpx; }
.menu-item { min-height: 96rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #edf1ea; font-size: 30rpx; }
.menu-item:last-child { border-bottom: 0; }
.menu-item text:last-child { color: #a1ad9b; font-size: 42rpx; }

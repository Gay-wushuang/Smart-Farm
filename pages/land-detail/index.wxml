<view class="page safe-bottom">
  <image class="hero" src="{{land.image || '/assets/images/land-default.svg'}}" mode="aspectFill" />
  <view class="detail panel">
    <view class="title-row"><view><view class="h2">{{land.landName || '土地详情'}}</view><view class="muted">编号 {{land.landNo || land.landId || id}}</view></view><status-tag text="{{statusText}}" type="{{canRent ? 'available' : 'default'}}"></status-tag></view>
    <view class="grid">
      <view><text>面积</text><text class="strong">{{land.area || '-'}}{{land.areaUnit || '㎡'}}</text></view>
      <view><text>年租价格</text><text class="strong">¥{{price}}</text></view>
      <view><text>剩余租期</text><text class="strong">{{land.remainDays || land.remainingDays || '-'}} 天</text></view>
      <view><text>位置区域</text><text class="strong">{{land.zone || '-'}}</text></view>
    </view>
  </view>
  <button class="primary-button action" disabled="{{!canRent}}" bindtap="goOrder">{{canRent ? '立即租赁' : '当前不可租赁'}}</button>
  <view class="error" wx:if="{{error}}">{{error}}</view>
</view>

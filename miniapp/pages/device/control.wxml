<view class="container">
  <view class="device-list">
    <view class="device-item" wx:for="{{devices}}" wx:key="id">
      <view class="device-name">{{item.name}}</view>
      <view class="device-status">状态：{{item.status === 1 ? '在线' : '离线'}}</view>
      <view class="device-actions">
        <button class="action-btn water" bindtap="doAction" data-action="water" data-id="{{item.id}}" wx:if="{{item.type === 'water'}}">浇水</button>
        <button class="action-btn fertilizer" bindtap="doAction" data-action="fertilizer" data-id="{{item.id}}" wx:if="{{item.type === 'fertilizer'}}">施肥</button>
      </view>
    </view>
  </view>
</view>

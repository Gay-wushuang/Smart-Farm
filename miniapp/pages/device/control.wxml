<view class="container">
  <view class="device-list">
    <view class="device-item">
      <view class="device-name">土地 {{landId}} 监测</view>
      <view class="device-status">温度：{{monitor.temperature}}℃</view>
      <view class="device-status">空气湿度：{{monitor.humidity}}%</view>
      <view class="device-status">土壤湿度：{{monitor.soilMoisture}}%</view>
      <view class="device-actions">
        <button class="action-btn water" bindtap="doAction" data-action="water">浇水</button>
        <button class="action-btn fertilizer" bindtap="doAction" data-action="fertilizer">施肥</button>
      </view>
    </view>
  </view>
</view>

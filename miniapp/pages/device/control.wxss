.container {
  padding: 20rpx;
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.device-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.device-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.device-status {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.device-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  color: white;
}

.water {
  background: #4a90e2;
}

.fertilizer {
  background: #8b5cf6;
}

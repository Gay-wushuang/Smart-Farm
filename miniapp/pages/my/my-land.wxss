.container {
  padding: 20rpx;
}

.my-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.my-item {
  display: flex;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.land-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.land-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.land-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.land-time {
  font-size: 24rpx;
  color: #999;
}

.land-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  background: #34a853;
  color: white;
}

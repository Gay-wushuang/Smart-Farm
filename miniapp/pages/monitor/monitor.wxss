.container {
  padding: 20rpx;
}

.monitor-container {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.monitor-image {
  width: 100%;
  height: 500rpx;
  background: #000;
}

.monitor-info {
  padding: 30rpx;
}

.monitor-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.monitor-time {
  font-size: 24rpx;
  color: #999;
}

.refresh-btn {
  width: 100%;
  background: #34a853;
  color: white;
  border-radius: 50rpx;
  margin-top: 40rpx;
}

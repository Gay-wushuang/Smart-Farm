.container {
  padding: 20rpx;
}

.filter {
  margin-bottom: 20rpx;
}

.search-input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
}

.land-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.land-item {
  display: flex;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
}

.land-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.land-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.land-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.land-location {
  font-size: 24rpx;
  color: #999;
}

.land-price {
  font-size: 36rpx;
  color: #ff6b35;
  font-weight: bold;
}

.state {
  padding: 48rpx 0;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.state.error {
  color: #e64340;
}
